# Job Finder Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git - it contains sensitive information

# ============================================================================
# GOOGLE CLOUD CONFIGURATION
# ============================================================================
# Your Google Cloud Project ID
# Find it at: https://console.cloud.google.com/ (top dropdown)
GOOGLE_CLOUD_PROJECT=your-project-id

# Path to your service account key JSON file
# This file should be in your project root (already in .gitignore)
# Get it from: Cloud Console → IAM & Admin → Service Accounts → Create Key
GOOGLE_APPLICATION_CREDENTIALS=service-account-key.json

# ============================================================================
# JOB BOARD API KEYS
# ============================================================================

# Adzuna API Credentials (FREE - Get from https://developer.adzuna.com/)
# 1. Create account at https://developer.adzuna.com/
# 2. Get your App ID and Key from dashboard
# Note: Free tier includes 1000 calls/month
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# JSearch API Key (FREE - Get from RapidAPI)
# 1. Sign up at https://rapidapi.com/
# 2. Subscribe to JSearch API: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# 3. Copy your API key from the dashboard
# Note: Free tier includes 100 requests/month
JSEARCH_API_KEY=your-rapidapi-key

# ============================================================================
# GMAIL CONFIGURATION (For Email Notifications)
# ============================================================================
# Your Gmail address
GMAIL_USER=your.email@gmail.com

# Gmail App Password (NOT your regular password)
# How to generate:
# 1. Enable 2-Factor Authentication on your Google account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate app password for "Mail"
# 4. Copy the 16-character password here (no spaces)
GMAIL_APP_PASSWORD=your-gmail-app-password

# ============================================================================
# GOOGLE DRIVE CONFIGURATION (For Resume Storage)
# ============================================================================
# Google Drive Folder ID where resumes will be uploaded
# How to get:
# 1. Create a folder in Google Drive
# 2. Open the folder
# 3. Copy the ID from URL: https://drive.google.com/drive/folders/[FOLDER_ID_HERE]
# 4. Share folder with your service account email (found in service-account-key.json)
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# ============================================================================
# OPTIONAL: PROXY SETTINGS
# ============================================================================
# Uncomment and configure if you need to use a proxy for web scraping
# HTTP_PROXY=http://proxy-server:port
# HTTPS_PROXY=https://proxy-server:port

# ============================================================================
# SETUP CHECKLIST
# ============================================================================
# [ ] 1. Created Google Cloud Project
# [ ] 2. Enabled required APIs (see SETUP_GUIDE.md)
# [ ] 3. Created service account and downloaded key JSON
# [ ] 4. Got Adzuna API credentials
# [ ] 5. Got JSearch/RapidAPI key
# [ ] 6. Generated Gmail App Password
# [ ] 7. Created Google Drive folder and got ID
# [ ] 8. Shared Drive folder with service account email
# [ ] 9. Filled in all values above
# [ ] 10. Renamed this file to .env (remove .template)
# [ ] 11. Verified .env is in .gitignore

# ============================================================================
# SECURITY NOTES
# ============================================================================
# - NEVER commit .env file to git
# - NEVER share your .env file publicly
# - Rotate keys if accidentally exposed
# - Keep service-account-key.json secure
# - Add .env to .gitignore (already done)
