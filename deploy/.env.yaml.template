# Gmail credentials for email notifications
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env.yaml in the same directory
# 2. Generate a Gmail App Password:
#    - Go to https://myaccount.google.com/apppasswords
#    - Sign in to your Google Account
#    - Select "Mail" and your device, then click "Generate"
#    - Copy the 16-character password
# 3. Replace the placeholder values below with your actual credentials
# 4. NEVER commit .env.yaml to Git (already in .gitignore)

GMAIL_USER: your-email@gmail.com
GMAIL_APP_PASSWORD: your-16-char-app-password
